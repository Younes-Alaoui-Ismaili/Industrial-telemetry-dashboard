# Copy to bridge/.env and fill in for your machine, then start the bridge with
#   node --env-file=.env src/index.js
# or export the variables yourself and run `npm start`. Nothing here is read from
# the repository: the path to the telemetry MCP server is yours, so it lives in
# your environment and never in a committed file. bridge/.env is git ignored.

# Executable that starts the telemetry MCP server.
TELEMETRY_MCP_COMMAND=node

# Arguments for it. Whitespace separated, or a JSON array when a path contains
# spaces, for example: ["C:/some path/dist/index.js"]
TELEMETRY_MCP_ARGS=../../telemetry-server/dist/index.js

# Optional. Port the bridge listens on, loopback only.
# PORT=8787

# Optional. Comma separated browser origins allowed to call the bridge.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
