{
  "name": "telemetry-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test test/api.test.ts test/connect-retry.test.ts",
    "test:sql": "tsx --test --test-concurrency=1 test/store.test.ts test/window.test.ts test/report.test.ts",
    "migrate": "tsx src/admin.ts migrate",
    "backup": "tsx src/admin.ts backup",
    "restore": "tsx src/admin.ts restore"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.5.0",
    "@azure/identity": "^4.13.0",
    "mssql": "^12.0.0",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/mssql": "^9.1.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
